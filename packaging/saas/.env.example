# ── Audra v2 SaaS Configuration Environment Variables Template ──
# Rename this file to '.env' and place it in the application deployment root.

# --- Flask Server Settings ---
FLASK_ENV=production
PORT=5050
HOST=0.0.0.0

# --- Resource Safety & Concurrency Limits ---
# Controls how many parallel FFmpeg rendering threads are allowed to execute
AUDRA_CONCURRENCY_LIMIT=2

# Maximum uploaded file size limit (in Megabytes)
AUDRA_MAX_FILE_SIZE_MB=100

# Target CPU threshold (forces thread throttle if active capacity exceeds this)
AUDRA_CPU_TARGET=80.0

# Memory watchdog ceiling limit (kills worker process if RAM footprint spikes above this)
AUDRA_MEMORY_LIMIT_MB=2048

# --- SaaS Licensing & Stripe Integration ---
# Enable SaaS API authentication checks. If set to 'false' (or omitted), 
# authentication checks are bypassed (default behavior for Standalone Desktop mode)
SAAS_AUTH_ENABLED=true

# Stripe Webhook verification key to validate incoming subscription upgrades/cancellations
SAAS_STRIPE_WEBHOOK_SECRET=whsec_yourstripewebhooksecretforvalidation

# Security signature token secret to validate user authorization headers
SAAS_JWT_SECRET=supersecureandsignedtokensecretforaudrav2users

# --- Executable Paths Override (Optional) ---
# If your cloud provider installs FFmpeg/FFprobe in non-standard paths, specify them here:
# AUDRA_FFMPEG_PATH=/usr/bin/ffmpeg
# AUDRA_FFPROBE_PATH=/usr/bin/ffprobe
