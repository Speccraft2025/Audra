{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "audra-server",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["server.py"],
      "port": 5050
    },
    {
      "name": "audra-server-licensed",
      "runtimeExecutable": "env",
      "runtimeArgs": ["AUDRA_LICENSING_ENABLED=true", ".venv/bin/python", "server.py"],
      "port": 5050
    },
    {
      "name": "landing-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8899", "-d", "site"],
      "port": 8899
    }
  ]
}
